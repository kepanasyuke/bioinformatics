#!/usr/bin/env bash
# ВЕРСИЯ ДО ИСПРАВЛЕНИЯ. Хранится как .orig, чтобы линтер её не проверял.
# Здесь намеренно собраны все ошибки из ISSUES.md: B1..B10.

DIR=/data/projects/rnaseq
TMP=/tmp/pipe

run_all() {
    cd $DIR
    for f in $(ls *.fastq); do
        sample=$(basename $f .fastq)
        if [ -f $f ]; then
            if [ -s $f ]; then
                if [ "$sample" != "" ]; then
                    if [ ! -e done_$sample ]; then
                        bwa mem -t 8 $REF $f > $TMP/out.sam
                        samtools sort $TMP/out.sam > $TMP/out.bam
                        echo $sample >> done.log
                    else
                        continue
                    fi
                fi
            fi
        fi
    done
    return 0
}

check_vcf() {
    if [ -f $1 ]; then
        if grep -q "PASS" $1; then
            return 0
        else
            return 1
        fi
    else
        return 2
    fi
}

cleanup() {
    rm -rf $TMP/
}

run_all
check_vcf $1
cleanup
